# =====================================================================
# 🛠️ HOW TO SET UP YOUR LOCAL .env FILE
# =====================================================================
#
# STEP 1: Open your terminal (Command Prompt, Git Bash, or Mac Terminal)
#         inside your project folder.
#
# STEP 2: Run ONE of these commands to create your .env file:
#
#   • Windows (Command Prompt / CMD):
#       copy .env.example .env
#
#   • Mac / Linux / Git Bash / VS Code Terminal:
#       cp .env.example .env
#
#   • Windows (PowerShell):
#       Copy-Item .env.example .env
#
#   (OR: Simply right-click this file, copy & paste it, and rename it to .env)
#
# STEP 3: Open the new .env file and replace the placeholder values below!
# =====================================================================

# Application Secret Key (Generate a random secret string)
APP_SECRET_KEY=your_secret_key_here

# Initial Setup Admin credentials
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=your_admin_password_here

# Signature Encryption Key
SIGNATURE_KEY=your_signature_key_here

# Local backup directory path
BACKUP_DIR=C:\path\to\your\backups

# Debug Toggle: Set to True to completely bypass Google Drive sync
DISABLE_CLOUD_SYNC=False
